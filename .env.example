# Copy this file to `.env` before running Docker Compose. All values are
# optional; Compose uses the defaults shown below when `.env` is absent.

# Port exposed on your computer.
HOST_PORT=3000

# Port used by the Vinext server inside the container. Normally leave this at
# 3000. If changed, Compose updates both the server and health check.
CONTAINER_PORT=3000

# Public origin used when generating canonical and social metadata.
# When HOST_PORT changes, update this URL to match.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resulting local image name and tag.
DOCKER_IMAGE=formspace-3dviewer:local
